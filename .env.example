# Settings for `npm start` and Docker Compose. Copy this file to .env
# (git-ignored: secrets never reach the repository) and fill in only what
# you need. Left as is, it changes nothing: people sign in with a name and
# an email, which is fine on your own machine.

# The address people use; sign-in providers send people back there.
# For a first try on your machine, open Myoboard at exactly this address.
PUBLIC_URL=http://localhost:3000

# --- Sign in with Google (optional) ----------------------------------------
# Personal or work accounts. README.md, "Sign-in", says how to get these two.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only accounts managed by these Google Workspace domains, comma-separated
# (e.g. example.com). Empty: any Google account, personal ones included.
GOOGLE_ALLOWED_DOMAINS=

# --- Sign in with another provider (optional) -------------------------------
# Microsoft Entra ID, Okta, Keycloak... any OpenID Connect provider.
# Microsoft: OIDC_ISSUER=https://login.microsoftonline.com/<tenant id>/v2.0
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_DOMAINS=
# Shown on the button ("Continue with ..."); guessed for Microsoft.
OIDC_PROVIDER_NAME=

# --- Sign in with a name and an email -----------------------------------------
# Nobody checks the address. On by default when no provider is set up, off
# otherwise; "on" keeps it next to a provider (on your own machine, say).
LOCAL_SIGN_IN=
