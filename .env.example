# Copy to .env (never committed) and fill in; `npm start` reads it.
# With Docker Compose, compose.yaml passes it to the container.

# The address people use. For a first try on your machine:
PUBLIC_URL=http://localhost:3000

# Sign in with Google Workspace (README: "Sign in with your company's accounts").
# Leave these three empty to sign in with a name and an email instead.
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Only accounts of these domains (comma-separated), e.g. example.com.
# With Google, they must also be managed by that Workspace domain.
OIDC_ALLOWED_DOMAINS=
