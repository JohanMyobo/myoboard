{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "fluid": true,
  "rewrites": [
    { "source": "/ws/:board", "destination": "/api/ws" },
    { "source": "/healthz", "destination": "/api/ws" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
